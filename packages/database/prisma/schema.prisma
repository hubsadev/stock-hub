generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum UserRole {
  ADMIN_STOCK
  GESTIONNAIRE_STOCK
  AUDIT
  RH
  DIRECTION
  CHEF_PROJET
}

enum TrackingMode {
  QUANTITY
  INDIVIDUAL
}

enum MovementType {
  ENTRY
  EXIT_REQUEST
  EXIT
  RETURN
  TRANSFER
  ADJUSTMENT
}

enum MovementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PREPARED
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id         String   @id @default(cuid())
  identifier String   @unique
  email      String?  @unique
  firstName  String
  lastName  String
  roles     UserRole[]
  passwordHash String @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamService {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   @default("SERVICE")
  manager   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id          String   @id @default(cuid())
  matricule   String   @unique
  lastName    String
  firstName   String
  department  String?
  role        String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  fiscalId  String?
  category  String?
  contact   String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipments Equipment[]
}

model Project {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  client           String?
  clientId         String?
  projectManagerId String?
  region           String?
  city             String?
  site             String?
  startDate        DateTime?
  endDate          DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sites Location[]
}

model Location {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String
  responsible String?
  region      String?
  city        String?
  address     String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevels StockLevel[]
}

model Article {
  id                String       @id @default(cuid())
  code              String       @unique
  designation       String
  category          String
  unit              String
  trackingMode      TrackingMode @default(QUANTITY)
  minimumStock      Int          @default(0)
  securityStock     Int          @default(0)
  referencePrice    Decimal?     @db.Decimal(18, 2)
  defaultSupplierId String?
  defaultLocationId String?
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stockLevels StockLevel[]
  equipment   Equipment[]
  movements   StockMovementLine[]
}

model Equipment {
  id           String   @id @default(cuid())
  code         String   @unique
  serialNumber String?
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id])
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  state        String   @default("GOOD")
  status       String   @default("AVAILABLE")
  assignedTo   String?
  locationId   String?
  entryDate    DateTime @default(now())
  origin       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history EquipmentHistory[]
}

model EquipmentHistory {
  id             String    @id @default(cuid())
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  action         String
  status         String?
  state          String?
  assignedTo     String?
  locationId     String?
  observation    String?
  createdAt      DateTime  @default(now())

  @@index([equipmentId, createdAt])
}

model StockLevel {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([articleId, locationId])
}

model StockMovement {
  id          String         @id @default(cuid())
  reference   String         @unique
  type        MovementType
  status      MovementStatus @default(DRAFT)
  date        DateTime
  supplierId  String?
  clientId    String?
  projectId   String?
  teamServiceId String?
  siteLocationId String?
  fromLocationId String?
  toLocationId   String?
  requestedBy String?
  handledBy   String?
  receivedBy  String?
  deliveredBy String?
  sourceRequestId String?
  proofFileName   String?
  proofUploadedAt DateTime?
  proofUploadedBy String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines StockMovementLine[]
  sourceRequest  StockMovement?  @relation("RequestGeneratedExits", fields: [sourceRequestId], references: [id], onDelete: SetNull)
  generatedExits StockMovement[] @relation("RequestGeneratedExits")

  @@index([sourceRequestId])
}

model StockMovementLine {
  id                  String        @id @default(cuid())
  movementId          String
  movement            StockMovement @relation(fields: [movementId], references: [id])
  articleId           String
  article             Article       @relation(fields: [articleId], references: [id])
  requestedQuantity   Int?
  expectedQuantity    Int?
  completedQuantity   Int?
  unitPrice           Decimal?      @db.Decimal(18, 2)
  observation          String?
  createdAt            DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model ImportBatch {
  id        String   @id @default(cuid())
  fileName  String
  status    String
  summary   Json?
  createdAt DateTime @default(now())
}
model Vehicle {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  type               String
  plateNumber        String   @unique
  assignment         String?
  driverName         String?
  apprenticeName     String?
  status             String   @default("AVAILABLE")
  insuranceExpiresAt DateTime?
  technicalVisitAt   DateTime?
  notes              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



